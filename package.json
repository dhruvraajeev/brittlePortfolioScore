{
  "name": "brittle",
  "private": true,
  "version": "1.0.0",
  "description": "Brittle — portfolio fragility score. Root scripts run the backend and frontend together.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && ../.venv/bin/uvicorn app:app --reload --port 8000",
    "dev:web": "cd frontend && npm run dev",
    "install:all": "npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "deploy": "cd vercel && vercel",
    "deploy:prod": "cd vercel && vercel --prod"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
